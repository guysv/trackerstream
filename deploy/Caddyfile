# trackerstream TLS endpoint (near-static).
#
# The Node.js control-plane API was retired with the Go cutover: catalog/search and IPNS
# distribution moved entirely into libp2p (custom DHT + gossipsub on tsnode), and the DESKTOP
# client still makes no HTTPS request to the box — it bootstraps from the multiaddrs baked
# into packages/config.
#
# The web client cannot: go-libp2p regenerates its WebRTC TLS cert on every process start, so
# the /certhash/... in the master's browser-dialable multiaddr changes on every seed restart.
# A browser therefore has to LOOK UP the live addr at page load — that, and nothing else, is
# what the one proxied route below (/bootstrap.json -> tsedge) exists for. Everything else
# here is still static. coturn/STUN (:3478) and the libp2p swarm (:5478) remain direct, not
# behind Caddy.
#
# This is a TEMPLATE: deploy/setup-tls.sh renders ${TS_DOMAIN} (envsubst) to the
# literal hostname into /etc/caddy/Caddyfile before starting Caddy. To run by hand:
#
#   TS_DOMAIN=trackerstream.xyz envsubst '${TS_DOMAIN}' < deploy/Caddyfile | caddy run --config -
#
# Caddy needs :80 (ACME HTTP-01 challenge + HTTP->HTTPS redirect) and :443.

${TS_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Playlist deep-link handoff (PLAYLISTS.md §10): every /p/<name> serves the ONE
	# static page (deploy/site/p.html, installed by setup-tls.sh), which parses the
	# name client-side and hands off to the desktop app. The payload rides the URL
	# FRAGMENT — it never reaches this server, so there is nothing to store or log.
	handle /p/* {
		root * /var/www/trackerstream
		rewrite * /p.html
		file_server
	}

	# Browser bootstrap (tsedge, :5090). The ONE dynamic route: the master's live
	# webrtc-direct multiaddr + ephemeral TURN credentials, re-fetched by every web client on
	# every page load (and again on any dial failure — a seed restart rotates the certhash
	# mid-TTL). Deliberately NOT proxied to tsnode's RPC: that surface is loopback-only by
	# design (unauthenticated block/put + pin/rm + name/publish), so it must never be exposed.
	# tsedge is a stateless read-only projection of it.
	handle /bootstrap.json {
		reverse_proxy 127.0.0.1:5090
	}

	handle {
		respond /healthz "ok" 200
		respond "trackerstream" 200
	}
	# Access logs go to journald (the default) — kept inside Caddy's systemd
	# sandbox, retention via journald (see deploy/backup.sh / D3 log rotation).
}
