{
  "name": "@trackerstream/desktop",
  "version": "0.1.0",
  "description": "trackerstream desktop client (Tauri + Svelte)",
  "type": "module",
  "scripts": {
    "build:worklet": "node ../../packages/ui/scripts/build-worklet.mjs static/player.worklet.js",
    "predev": "pnpm prepare:sidecar && pnpm build:worklet",
    "dev": "node scripts/dev.mjs",
    "dev:locked": "node scripts/dev-locked.mjs",
    "prebuild": "pnpm prepare:sidecar && pnpm build:worklet",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm --filter @trackerstream/ui test",
    "tauri": "tauri",
    "prepare:sidecar": "bash src-tauri/scripts/prepare-sidecar.sh"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@trackerstream/config": "workspace:*",
    "@trackerstream/wasm": "workspace:*",
    "@trackerstream/ui": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.24.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
